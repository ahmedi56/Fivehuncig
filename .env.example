# Copy to .env.local and fill in. Never commit real keys, and never prefix secrets with EXPO_PUBLIC_
# (EXPO_PUBLIC_ variables are compiled into the app and visible to anyone).

# Server-only: used by src/app/api/chat+api.ts. Without it the chat shows "not set up" and
# everything else keeps working offline.
ANTHROPIC_API_KEY=

# Optional: override the chat model (default claude-opus-5-5).
CHAT_MODEL=

# Community (Supabase). Both values are public by design: the publishable key only allows what
# the database functions allow (see supabase/migrations). Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, recommended: hCaptcha site key (public) when CAPTCHA is on in Supabase
# (Authentication → Attack Protection → hCaptcha). The hCaptcha *secret* goes only in that
# Supabase setting, never here. Without a site key, members join without a check.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
