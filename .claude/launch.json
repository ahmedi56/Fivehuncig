{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "expo-web-release-features",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set EXPO_PUBLIC_FEATURE_CHAT=0&& set EXPO_PUBLIC_FEATURE_COMMUNITY=0&& npx expo start --web --port 8083"],
      "port": 8083
    },
    {
      "name": "graph-view",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--bind", "127.0.0.1", "--directory", "graphify-out"],
      "port": 8090
    }
  ]
}
